# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Servidor de produção (VPS). Ler no .env via `import "dotenv/config"`.
# Depois de alterar: pm2 reload manos --update-env
# ---------------------------------------------------------------------------

# Painel interno /leads-manos (Basic Auth).
# SEM PANEL_PASSWORD o painel responde 503 — falha fechada de propósito.
# Gere uma senha longa: openssl rand -base64 24
PANEL_USER="manos"
PANEL_PASSWORD=""

# Meta Conversions API (envio server-side dos eventos de Lead/ViewContent/
# AddToCart/Purchase). Token do Gerenciador de Eventos -> pixel ->
# Configurações -> gerar token. Sem token, o envio server-side é ignorado em
# silêncio (o pixel do navegador segue normal).
META_CAPI_TOKEN=""
# Opcional, só enquanto estiver testando no Gerenciador de Eventos:
META_TEST_EVENT_CODE=""
# Pixel/dataset do catálogo no Gerenciador de Comércio. Não é segredo — só
# está em variável para trocar sem mexer em código. Sem ela, usa o pixel de
# produção (3253946971444443) como default.
META_PIXEL_ID="3253946971444443"
# Segredo do endpoint /api/meta/venda-confirmada (evento Purchase). O CRM/n8n
# manda este valor no header x-webhook-secret ao confirmar uma venda.
# Gere um valor longo: openssl rand -base64 24
META_WEBHOOK_SECRET=""

# --- Mapeamento placa -> content_id do catálogo (server/catalogSync.ts) ------
# O catálogo do Gerenciador de Comércio é alimentado pela Autos 360 e numera os
# veículos do jeito dela: o id da Altimus não é o content_id da Meta. Sem as
# variáveis abaixo, o site manda o id da Altimus e a correspondência do catálogo
# fica em 0% — o pixel funciona, mas a Meta não reconhece o produto.
#
# Catálogo Altimus_Veiculos. Não é segredo; está aqui para trocar sem mexer em
# código.
META_CATALOG_ID="712583511204994"
# Token de System User com permissão catalog_management NESSE catálogo
# (Configurações da Empresa -> Usuários do sistema). É DIFERENTE do META_CAPI_TOKEN.
META_CATALOG_ACCESS_TOKEN=""
# Chave service_role do Supabase. A tabela vehicle_meta_mapping guarda placa e é
# service-role-only, então a chave publishable usada em lead_scores não serve.
SUPABASE_SERVICE_ROLE_KEY=""
# Segredo de /api/internal/sync-catalog-mapping, a rota que roda a sincronização
# (agendada por pg_cron; ver comentário da rota em server.ts).
# Gere um valor longo: openssl rand -base64 24
INTERNAL_SYNC_SECRET=""

# OpenAI Ads Conversions API (envio server-side dos eventos de Lead).
# Ads Manager -> Conversoes -> Eventos de conversao -> "Criar chave de conversao".
# Sem chave, o envio server-side e ignorado em silencio (o pixel oaiq segue normal).
OPENAI_ADS_API_KEY=""
# Pixel do OpenAI Ads. Obrigatorio junto com a chave — sem ele o envio
# server-side nao acontece (nao ha default embutido, de proposito: um id
# errado mandaria conversao para a conta de outro).
OPENAI_ADS_PIXEL_ID="QhX8YkwW1KcmEMR9JPQD8Q"
# O MESMO pixel, lido pelo Vite no build do front. Nao e segredo: ele vai para
# o navegador de qualquer jeito. Esta em variavel para dar para trocar de conta
# sem editar codigo. Sem ele, o pixel simplesmente nao inicializa.
VITE_OPENAI_ADS_PIXEL_ID="QhX8YkwW1KcmEMR9JPQD8Q"

# Senhas de Acesso Administrativo (Vite / Frontend)
VITE_ADMIN_PASSWORD="sua_senha_aqui"
VITE_REPASSE_ADMIN_PASSWORD="sua_senha_aqui"
VITE_BOLAO_ADMIN_PASSWORD="sua_senha_aqui"
